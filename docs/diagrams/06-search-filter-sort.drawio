<mxfile host="app.diagrams.net"><diagram name="06-search-filter-sort"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1654" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="D06. Поиск, фильтрация и сортировка в реальном времени" style="text;html=1;fontSize=17;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="10.0" y="-35.0" width="835.0" height="30" as="geometry"/></mxCell><mxCell id="s" value="Начало: каталог менеджера или администратора" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#DCE8F5;strokeColor=#2E5C8A;fontSize=13;" vertex="1" parent="1"><mxGeometry x="240" y="15" width="320" height="50" as="geometry"/></mxCell><mxCell id="chg" value="Изменён текст поиска, поставщик или порядок сортировки" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=14;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#2F7D4A;fontSize=13;" vertex="1" parent="1"><mxGeometry x="245" y="110" width="310" height="60" as="geometry"/></mxCell><mxCell id="all" value="Взять все товары из БД" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A3A3A;fontSize=13;" vertex="1" parent="1"><mxGeometry x="265" y="213" width="270" height="54" as="geometry"/></mxCell><mxCell id="sq" value="Строка поиска пуста?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF3D1;strokeColor=#B7860B;fontSize=13;" vertex="1" parent="1"><mxGeometry x="290" y="300" width="220" height="100" as="geometry"/></mxCell><mxCell id="srch" value="Оставить товары, где текст есть в артикуле, названии, описании, категории или производителе" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A3A3A;fontSize=13;" vertex="1" parent="1"><mxGeometry x="575" y="305" width="270" height="90" as="geometry"/></mxCell><mxCell id="j1" value="" style="ellipse;fillColor=#2B2B