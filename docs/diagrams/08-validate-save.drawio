<mxfile host="app.diagrams.net"><diagram name="08-validate-save"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1654" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="D08. Проверка данных и сохранение товара" style="text;html=1;fontSize=17;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="5.0" y="-32.0" width="840.0" height="30" as="geometry"/></mxCell><mxCell id="s" value="Начало: нажата кнопка «Сохранить»" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#DCE8F5;strokeColor=#2E5C8A;fontSize=13;" vertex="1" parent="1"><mxGeometry x="260" y="18" width="280" height="44" as="geometry"/></mxCell><mxCell id="frm" value="Данные товара на форме" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=14;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#2F7D4A;fontSize=13;" vertex="1" parent="1"><mxGeometry x="265" y="103" width="270" height="54" as="geometry"/></mxCell><mxCell id="req" value="Проверить обязательные поля: название, категория, цена, остаток" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A3A3A;fontSize=13;" vertex="1" parent="1"><mxGeometry x="250" y="193" width="300" height="64" as="geometry"/></mxCell><mxCell id="f1" value="Все обязательные поля заполнены?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF3D1;strokeColor=#B7860B;fontSize=13;" vertex="1" parent="1"><mxGeometry x="285" y="293" width="230" height="104" as="geometry"/></mxCell><mxCell id="m1" value="Подсветить пустые поля и подсказать, что заполнить" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=14;whiteSpace=wrap;html=1;fillColor=#FBE3E3;strokeColor=#B03A3A;fontSize=13;" vertex="1" parent="1"><mxGeometry x="595" y="313" width="250" height="64" as="geometry"/></mxCell><mxCell id="f2" value="Цена ≥ 0, остаток ≥ 0,