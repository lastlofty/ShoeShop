 пустую форму, поле ID скрыто" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A3A3A;fontSize=13;" vertex="1" parent="1"><mxGeometry x="10" y="363" width="200" height="64" as="geometry"/></mxCell><mxCell id="load" value="Загрузить поля выбранного товара из БД" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A3A3A;fontSize=13;" vertex="1" parent="1"><mxGeometry x="265" y="483" width="270" height="54" as="geometry"/></mxCell><mxCell id="ro" value="Показать ID только для чтения" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A3A3A;fontSize=13;" vertex="1" parent="1"><mxGeometry x="265" y="573" width="270" height="54" as="geometry"/></mxCell><mxCell id="lists" value="Заполнить списки категорий и производителей" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A3A3A;fontSize=13;" vertex="1" parent="1"><mxGeometry x="255" y="663" width="290" height="54" as="geometry"/></mxCell><mxCell id="opn" value="Открыть форму модально, второе окно не открывается" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A3A3A;fontSize=13;" vertex="1" parent="1"><mxGeometry x="250" y="755" width="300" height="60" as="geometry"/></mxCell><mxCell id="end" value="Конец" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#DCE8F5;strokeColor=#2E5C8A;fontSize=13;" vertex="1" parent="1"><mxGeometry x="300" y="858" width="200" height="44" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;rounded=0;fontStyle=1;fontSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s" target="act"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;rounded=0;fontStyle=1;fontSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" sou